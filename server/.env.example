NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/zion-armor-outpost
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173

# Portfolio demo mode. Orders are placed and XP is awarded as normal, but stock
# is never decremented, so visitors cannot empty the racks over time.
# Set to false for real inventory behaviour.
DEMO_MODE=true
